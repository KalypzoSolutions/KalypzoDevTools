{
  "schemaVersion": 1,
  "id": "fim",
  "version": "${version}",
  "name": "Fish's Integrated Minecraft",
  "description": "Adds IntelliJ integration to Minecraft.",
  "authors": [
    "Offensichtlich",
    "ACraftingFish"
  ],
  "contact": {
    "sources": "https://github.com/Offensichtliches/FIM-Fabric"
  },
  "license": "MIT License",
  "icon": "assets/fim/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "fish.crafting.fimfabric.client.FIMModDataGenerator"
    ],
    "client": [
      "fish.crafting.fimfabric.client.FIMModClient"
    ],
    "main": [
      "fish.crafting.fimfabric.FIMMod"
    ]
  },
  "mixins": [
    "fim.mixins.json",
    {
      "config": "fim.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
